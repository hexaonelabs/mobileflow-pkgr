# Copier en .env pour le développement local (jamais commité — voir .gitignore)
REDIS_URL="redis://localhost:6379"

# URL de l'app frontend (redirection après OAuth) et du backend (callbacks OAuth).
# API_URL doit être publiquement joignable pour la signature iOS (Phase 5) : le job build-ios
# d'un run GitHub Actions l'appelle directement pour récupérer les secrets de signature via
# GET /internal/secrets (token de run à courte durée de vie). En local (localhost), ce
# rappel échoue silencieusement — attendu tant que l'API n'est pas déployée publiquement.
FRONTEND_URL="http://localhost:4200"
API_URL="http://localhost:3000"

# Auth
JWT_SECRET="change-me-in-production"

# Secret Vault (Phase 4) — clé maître pour dériver une clé de chiffrement par utilisateur (HKDF + AES-256-GCM).
# Générer une valeur locale avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY="change-me-in-production"

# Google OAuth (login utilisateur — console Google Cloud)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/oauth/google/callback"

# GitHub OAuth App (login utilisateur — distinct de la GitHub App d'installation utilisée en Phase 2)
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""
GITHUB_OAUTH_CALLBACK_URL="http://localhost:3000/auth/oauth/github/callback"

# Firebase Admin SDK (compte de service, Firestore) — Console Firebase > Paramètres du projet
# > Comptes de service > Générer une nouvelle clé privée (fichier JSON)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Coller la valeur de "private_key" du JSON telle quelle (avec les \n littéraux, entre guillemets)
FIREBASE_PRIVATE_KEY=""

# GitHub App (installation — accès repos/Actions, distincte de la GitHub OAuth App de login)
# Créée sur https://github.com/settings/apps/new — Setup URL : ${FRONTEND_URL}/github/connect/callback
# Permissions requises : Contents (read/write), Actions (read/write), Metadata (read)
GITHUB_APP_SLUG=""
GITHUB_APP_ID=""
# Coller la clé privée générée pour la GitHub App (avec les \n littéraux, entre guillemets)
GITHUB_APP_PRIVATE_KEY=""
