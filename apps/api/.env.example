# Copier en .env pour le développement local (jamais commité — voir .gitignore)
REDIS_URL="redis://localhost:6379"

# URL de l'app frontend (redirection après OAuth) et du backend (callbacks OAuth).
# API_URL doit être publiquement joignable pour la signature iOS (Phase 5) : le job build-ios
# d'un run GitHub Actions l'appelle directement pour récupérer les secrets de signature via
# GET /internal/secrets (token de run à courte durée de vie). En local (localhost), ce
# rappel échoue silencieusement — attendu tant que l'API n'est pas déployée publiquement.
FRONTEND_URL="http://localhost:4200"
API_URL="http://localhost:3000"

# Auth
JWT_SECRET="change-me-in-production"

# Secret Vault (Phase 4) — clé maître pour dériver une clé de chiffrement par utilisateur (HKDF + AES-256-GCM).
# Générer une valeur locale avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY="change-me-in-production"

# Google OAuth (login utilisateur — console Google Cloud)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/oauth/google/callback"

# GitHub OAuth App (login utilisateur — distinct de la GitHub App d'installation utilisée en Phase 2)
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""
GITHUB_OAUTH_CALLBACK_URL="http://localhost:3000/auth/oauth/github/callback"

# Firebase Admin SDK (compte de service, Firestore) — Console Firebase > Paramètres du projet
# > Comptes de service > Générer une nouvelle clé privée (fichier JSON)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Coller la valeur de "private_key" du JSON telle quelle (avec les \n littéraux, entre guillemets)
FIREBASE_PRIVATE_KEY=""
# Bucket Firebase Storage (Console Firebase > Storage) où sont hébergés les .ipa/.apk buildés,
# pour l'installation OTA iOS (manifest.plist / itms-services) et le téléchargement direct.
# Le compte de service ci-dessus doit avoir le rôle "Storage Object Admin" sur ce bucket.
FIREBASE_STORAGE_BUCKET=""

# GitHub App (installation — accès repos/Actions, distincte de la GitHub OAuth App de login)
# Créée sur https://github.com/settings/apps/new — Setup URL : ${FRONTEND_URL}/github/connect/callback
# Permissions requises : Contents (read/write), Actions (read/write), Metadata (read)
GITHUB_APP_SLUG=""
GITHUB_APP_ID=""
# Coller la clé privée générée pour la GitHub App (avec les \n littéraux, entre guillemets)
GITHUB_APP_PRIVATE_KEY=""

# Webhook GitHub (détection fiable de fin de build, indépendante du polling client) :
# 1. Sur la page de la GitHub App (https://github.com/settings/apps/<slug>) : activer
#    l'événement "Workflow runs" dans Webhook > Subscribe to events.
# 2. Renseigner l'URL du webhook : https://<domaine-api>/github/webhook
# 3. Générer un secret (ex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
#    et coller la même valeur ici et dans le champ "Webhook secret" de la GitHub App.
GITHUB_WEBHOOK_SECRET="change-me-in-production"

# SMTP (notifications email de fin de build) — n'importe quel serveur SMTP standard convient.
# Hébergement décidé (PHASE_2_TASKS.md Step 0) : mailbox sur le VPS Infomaniak existant
# (ex: notifications@mobileflow.app), pas de Firebase Function. SMTP_FROM doit être une
# adresse sur le même domaine que l'API. Vérifier les enregistrements SPF/DKIM du domaine
# d'envoi si celui-ci est nouveau.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Stripe (abonnements free/starter) — clé secrète du Dashboard Stripe (mode test : sk_test_...)
STRIPE_SECRET_KEY=""
# Généré par `stripe listen --forward-to localhost:3000/stripe/webhook` en local (whsec_...),
# ou par le endpoint webhook configuré dans le Dashboard Stripe en production.
STRIPE_WEBHOOK_SECRET=""
# Price ID (récurrent) des produits Stripe déjà créés — Dashboard Stripe > Produits > <produit> > Prices
STRIPE_PRICE_FREE=""
STRIPE_PRICE_STARTER=""
