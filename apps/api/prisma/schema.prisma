// Prisma schema — reflète le modèle de données de specs/001-mobileflow-mvp/spec.md §1
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  email
  google
  github
}

enum Plan {
  free
  starter
  pro
  enterprise
}

enum Framework {
  capacitor
}

enum Platform {
  android
  ios
}

enum Environment {
  staging
  production
}

enum SecretType {
  apple_certificate
  apple_provisioning_profile
  apple_asc_api_key
  android_keystore
}

enum BuildTrigger {
  manual
  push
}

enum BuildStatus {
  queued
  running
  success
  failed
  cancelled
}

model User {
  id                    String       @id @default(uuid())
  email                 String       @unique
  authProvider          AuthProvider
  passwordHash          String?
  githubInstallationId  String?
  plan                  Plan         @default(free)
  projects              Project[]
  builds                Build[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

model Project {
  id                 String        @id @default(uuid())
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  name               String
  githubRepoFullName String
  framework          Framework     @default(capacitor)
  defaultBranch      String
  platforms          Platform[]
  buildConfigs       BuildConfig[]
  secrets            Secret[]
  builds             Build[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model BuildConfig {
  id                String      @id @default(uuid())
  project           Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         String
  environment       Environment
  envVars           Json        @default("{}")
  platforms         Platform[]
  autoTriggerBranch String?
  builds            Build[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Secret {
  id               String     @id @default(uuid())
  project          Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId        String
  type             SecretType
  encryptedPayload Bytes
  metadata         Json        @default("{}")
  uploadedAt       DateTime    @default(now())
}

model Build {
  id              String       @id @default(uuid())
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  buildConfig     BuildConfig  @relation(fields: [buildConfigId], references: [id], onDelete: Restrict)
  buildConfigId   String
  triggeredBy     BuildTrigger
  commitSha       String
  branch          String
  platform        Platform
  status          BuildStatus  @default(queued)
  githubRunId     String?
  startedAt       DateTime?
  finishedAt      DateTime?
  durationSeconds Int?
  artifactUrl     String?
  logsUrl         String?
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId          String?
  createdAt       DateTime     @default(now())
}
