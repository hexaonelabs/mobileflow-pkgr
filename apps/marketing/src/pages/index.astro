---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import StackStrip from '../components/StackStrip.astro';
import FrictionWall from '../components/FrictionWall.astro';
import Pipeline from '../components/Pipeline.astro';
import Shift from '../components/Shift.astro';
import FoundingOffer from '../components/FoundingOffer.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />
  <main id="main-content">
    {/* Promise → recognition → demonstration → contrast → offer. */}
    <Hero />
    <StackStrip />
    <FrictionWall />
    <Pipeline />
    <Shift />
    <FoundingOffer />
  </main>
  <Footer />
</Layout>
