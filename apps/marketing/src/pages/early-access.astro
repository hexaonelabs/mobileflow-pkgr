---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { FOUNDER_SPOTS, FOUNDER_PRICE_CHF, ACCESS_DEADLINE } from '../config';

const stripeLink =
  import.meta.env.PUBLIC_STRIPE_PAYMENT_LINK ?? 'https://buy.stripe.com/REPLACE_WITH_YOUR_LINK';
const cryptoAddress =
  import.meta.env.PUBLIC_CRYPTO_USDC_ADDRESS ?? '0xdbcC75e1ac8765A3C1AD07826B3693983afDb3a9';
const contactEmail = 'hello@mobileflow.dev';

const perks = [
  'Lifetime access — no subscription, ever',
  'Direct input on which features ship next',
  'Founding price: CHF 250 once, instead of a future subscription',
];
---

<Layout
  title="Get lifetime access"
  description="MobileFlow is opening early access at a one-time founding price of CHF 250 for lifetime access, before pricing moves to a subscription."
>
  <Header />
  <main id="main-content">
    <section class="py-24 sm:py-32">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <p
          class="text-accent-700 bg-accent-50 mb-6 inline-flex items-center rounded-full px-3 py-1 text-sm font-medium"
        >
          Early access · Founding price
        </p>
        <h1 class="text-4xl font-extrabold tracking-tight text-neutral-900 sm:text-5xl">
          Get MobileFlow for life
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-lg text-neutral-600">
          We're capping founding access at {FOUNDER_SPOTS} developers, total. This is a one-time founding
          price — once MobileFlow launches publicly, pricing moves to a recurring subscription. Everyone
          who joins now keeps lifetime access, no subscription, ever.
        </p>

        <div
          class="mx-auto mt-10 inline-flex items-baseline gap-2 rounded-2xl border border-neutral-200 px-8 py-6"
        >
          <span class="text-5xl font-extrabold tracking-tight text-neutral-900"
            >CHF {FOUNDER_PRICE_CHF}</span
          >
          <span class="text-sm text-neutral-500">one-time · lifetime access</span>
        </div>

        <div class="mt-14 grid gap-6 text-left sm:grid-cols-2">
          <div class="rounded-2xl border border-neutral-200 p-6">
            <h2 class="text-base font-semibold text-neutral-900">Pay with card</h2>
            <p class="mt-2 text-sm text-neutral-600">
              Secure checkout via Stripe. Your email is captured automatically so we can confirm
              your lifetime access.
            </p>
            <a
              href={stripeLink}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-accent-600 hover:bg-accent-700 focus-visible:ring-accent-600 mt-6 inline-flex w-full items-center justify-center rounded-full px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors focus-visible:ring-2 focus-visible:outline-none"
            >
              Pay CHF 250 with card
            </a>
          </div>

          <div class="rounded-2xl border border-neutral-200 p-6">
            <h2 class="text-base font-semibold text-neutral-900">Pay with crypto</h2>
            <p class="mt-2 text-sm text-neutral-600">
              No intermediary — send USDC directly on <strong>Arbitrum One</strong> to the address below.
            </p>
            <div
              class="mt-4 flex items-center gap-2 rounded-lg border border-neutral-200 bg-neutral-50 px-3 py-2.5"
            >
              <code id="crypto-address" class="flex-1 truncate font-mono text-xs text-neutral-700">
                {cryptoAddress}
              </code>
              <button
                type="button"
                id="copy-address-button"
                data-address={cryptoAddress}
                class="focus-visible:ring-accent-600 flex-none rounded-md border border-neutral-300 px-2.5 py-1.5 text-xs font-medium text-neutral-700 transition-colors hover:bg-white focus-visible:ring-2 focus-visible:outline-none"
              >
                Copy
              </button>
            </div>
            <p class="mt-3 text-xs text-neutral-500">
              Double-check the network (Arbitrum One) and token (USDC) before sending — crypto
              transfers can't be reversed.
            </p>
            <p class="mt-4 text-sm text-neutral-600">
              After sending, email your transaction hash to{' '}
              <a
                href={`mailto:${contactEmail}`}
                class="text-accent-600 hover:text-accent-700 font-medium"
              >
                {contactEmail}
              </a>{' '}
              so we can confirm your lifetime access.
            </p>
          </div>
        </div>

        <div class="mt-8 rounded-2xl border border-amber-200 bg-amber-50 p-5 text-left">
          <p class="text-sm font-semibold text-amber-900">MobileFlow is still under development</p>
          <p class="mt-1.5 text-sm text-amber-800">
            If you don't have access to the product by <strong>{ACCESS_DEADLINE}</strong>, we'll
            refund your CHF {FOUNDER_PRICE_CHF} in full — no questions asked. Card payments are refunded
            via Stripe; crypto payments are sent back to the wallet you paid from.
          </p>
        </div>

        <ul class="mt-8 grid gap-4 text-left sm:grid-cols-3">
          {
            perks.map((perk) => (
              <li class="flex gap-3 rounded-xl border border-neutral-200 p-5 text-sm text-neutral-700">
                <svg
                  aria-hidden="true"
                  class="text-accent-600 mt-0.5 h-5 w-5 flex-none"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                <span>{perk}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const copyButton = document.getElementById('copy-address-button');

  copyButton?.addEventListener('click', async () => {
    const address = copyButton.dataset.address ?? '';
    try {
      await navigator.clipboard.writeText(address);
      const original = copyButton.textContent;
      copyButton.textContent = 'Copied!';
      setTimeout(() => {
        copyButton.textContent = original;
      }, 2000);
    } catch {
      // Clipboard API unavailable — the address remains selectable as plain text.
    }
  });
</script>
