---
import PageLayout from '../layouts/PageLayout.astro';

const steps = [
  {
    title: '1. Connect your repository',
    body: 'Install the MobileFlow GitHub App from your account, then pick the repository and branch you want to build.',
  },
  {
    title: '2. Configure your build',
    body: 'Choose a platform (Android, iOS, or both), set your environment variables, and upload signing certificates and keystores to the Secret Vault.',
  },
  {
    title: '3. Trigger a build',
    body: 'Push to your configured branch to trigger a build automatically, or start one manually from the dashboard at any time.',
  },
  {
    title: '4. Download your artifact',
    body: 'Once the build completes, download the signed binary and review logs, duration, and commit details from the build history.',
  },
];
---

<PageLayout
  title="Documentation"
  description="Get started with MobileFlow: connect a repo, configure secrets, and trigger your first signed build."
  eyebrow="Docs"
>
  <p>
    This is a quick-start guide to your first MobileFlow build. In-depth reference docs are on the
    way — for anything not covered here, <a href="/contact">reach out</a>.
  </p>

  {
    steps.map((step) => (
      <>
        <h2>{step.title}</h2>
        <p>{step.body}</p>
      </>
    ))
  }

  <h2>Not in yet?</h2>
  <p>
    MobileFlow is currently in early access. <a href="/early-access">Get lifetime access</a> or
    <a href="/contact">contact us</a> if you run into an issue.
  </p>
</PageLayout>
