---
const points = [
  'Certificates, provisioning profiles, and keystores encrypted at rest',
  'Secrets transmitted over TLS, never exposed to the client',
  'Reused automatically on every build — upload once',
  'Short-lived run tokens fetch only what a given build needs',
];
---

<section class="py-24 sm:py-32">
  <div class="mx-auto grid max-w-6xl items-center gap-16 px-6 lg:grid-cols-2">
    <div class="order-2 lg:order-1">
      <div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-8">
        <div class="flex items-center gap-3">
          <div
            class="bg-accent-600 flex h-10 w-10 items-center justify-center rounded-lg text-white"
            aria-hidden="true"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75M4.5 10.5h15v9a1.5 1.5 0 01-1.5 1.5h-12a1.5 1.5 0 01-1.5-1.5v-9z"
              ></path>
            </svg>
          </div>
          <p class="font-semibold text-neutral-900">Secret Vault</p>
        </div>
        <ul class="mt-6 space-y-3 text-sm text-neutral-700">
          <li class="flex items-center justify-between rounded-lg bg-white px-4 py-3 shadow-sm">
            <span>ios_distribution.p12</span>
            <span class="text-xs font-medium text-green-600">Encrypted</span>
          </li>
          <li class="flex items-center justify-between rounded-lg bg-white px-4 py-3 shadow-sm">
            <span>android_release.keystore</span>
            <span class="text-xs font-medium text-green-600">Encrypted</span>
          </li>
          <li class="flex items-center justify-between rounded-lg bg-white px-4 py-3 shadow-sm">
            <span>app_store_connect_key.p8</span>
            <span class="text-xs font-medium text-green-600">Encrypted</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="order-1 lg:order-2">
      <h2 class="text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
        Your signing secrets, locked down
      </h2>
      <p class="mt-4 text-lg text-neutral-600">
        Stop passing certificates and keystores around. Upload them once to the Secret Vault and let
        MobileFlow handle signing on every build.
      </p>
      <ul class="mt-8 space-y-4">
        {
          points.map((point) => (
            <li class="flex gap-3 text-neutral-700">
              <svg
                aria-hidden="true"
                class="text-accent-600 mt-0.5 h-5 w-5 flex-none"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span>{point}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
