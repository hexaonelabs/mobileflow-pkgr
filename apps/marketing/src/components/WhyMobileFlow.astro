---
const benefits = [
  'No Mac required — build iOS and Android from any machine',
  'Powered by GitHub Actions, not a black-box build farm',
  'EU data residency by default, built with GDPR in mind',
  'Ephemeral, isolated runners for every single build',
  'Certificates and keystores never leave the Vault',
  'Manual or automatic triggers, your call every time',
];
---

<section id="why-mobileflow" class="py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
        Why teams choose MobileFlow
      </h2>
      <p class="mt-4 text-lg text-neutral-600">
        A cloud delivery pipeline built for developers who'd rather ship than manage infrastructure.
      </p>
    </div>

    <ul class="mt-14 grid gap-x-8 gap-y-6 sm:grid-cols-2">
      {
        benefits.map((benefit) => (
          <li class="flex gap-3 text-neutral-700">
            <svg
              aria-hidden="true"
              class="text-accent-600 mt-0.5 h-5 w-5 flex-none"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>{benefit}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
