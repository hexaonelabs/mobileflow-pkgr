---
import { FOUNDER_SPOTS, FOUNDER_PRICE_CHF } from '../config';

const steps = [
  { label: 'Fetching repository', detail: 'github.com/acme/store-app' },
  { label: 'Installing dependencies', detail: '412 packages' },
  { label: 'Building iOS (release)', detail: 'xcodebuild archive' },
  { label: 'Signing with Vault keystore', detail: 'ios_distribution.p12' },
];
---

<section class="relative isolate overflow-hidden pt-16 pb-20 sm:pt-24 sm:pb-28">
  <div class="aurora" aria-hidden="true">
    <div
      class="aurora-blob animate-drift top-[-32%] left-[8%] h-[560px] w-[720px] opacity-25"
      style="background: radial-gradient(closest-side, var(--color-accent-300), transparent);"
    >
    </div>
    <div
      class="aurora-blob animate-drift top-[-18%] right-[-6%] h-[480px] w-[620px] opacity-15"
      style="background: radial-gradient(closest-side, var(--color-accent-200), transparent); animation-delay: -7s;"
    >
    </div>
  </div>

  <div class="mx-auto grid max-w-6xl items-center gap-14 px-6 lg:grid-cols-[1.05fr_1fr] lg:gap-12">
    <div>
      <a
        href="#founding-access"
        class="glass hairline focus-visible:ring-accent-600 group inline-flex items-center gap-2.5 rounded-full py-1.5 pr-4 pl-1.5 text-sm font-medium text-neutral-700 transition-colors hover:text-neutral-900 focus-visible:ring-2 focus-visible:outline-none"
      >
        <span
          class="bg-accent-600 inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-semibold text-white"
        >
          <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-white"></span>
          </span>
          Founding access
        </span>
        {FOUNDER_SPOTS} lifetime spots
        <span
          class="text-accent-600 transition-transform duration-300 group-hover:translate-x-0.5"
          aria-hidden="true">→</span
        >
      </a>

      <h1
        class="mt-7 text-[2.6rem] leading-[1.05] font-extrabold tracking-[-0.03em] text-neutral-900 sm:text-6xl"
      >
        Ship mobile apps<br />
        <span class="relative inline-block">
          <span class="text-accent-700"> without a Mac. </span>
        </span>
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-neutral-600">
        pkgr.app builds, signs and delivers your Capacitor app for iOS and Android on every push to
        GitHub. <span class="font-semibold text-neutral-900">Without ever touching a Mac</span> — no
        Xcode, no Android Studio, no pipeline to maintain.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="/early-access"
          class="group bg-accent-600 hover:bg-accent-700 focus-visible:ring-accent-600 relative overflow-hidden rounded-full px-7 py-3.5 text-center text-base font-semibold text-white shadow-lg shadow-indigo-600/25 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-indigo-600/35 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none active:translate-y-0"
        >
          <span class="relative">Get lifetime access — CHF {FOUNDER_PRICE_CHF}</span>
        </a>
        <a
          href="#pipeline"
          class="glass hairline focus-visible:ring-accent-600 group inline-flex items-center justify-center gap-2 rounded-full px-6 py-3.5 text-center text-base font-semibold text-neutral-800 transition-all duration-300 hover:-translate-y-0.5 focus-visible:ring-2 focus-visible:outline-none active:translate-y-0"
        >
          <svg
            aria-hidden="true"
            class="text-accent-600 h-4 w-4 transition-transform duration-300 group-hover:scale-110"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M8 5.5v13l11-6.5z"></path>
          </svg>
          Watch it build
        </a>
      </div>

      <p class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-neutral-500">
        <svg
          aria-hidden="true"
          class="h-4 w-4 flex-none text-green-600"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4.5 12.75l6 6 9-13.5"></path>
        </svg>
        One payment, no subscription — refunded in full if we miss the deadline.
      </p>
    </div>

    <!-- Live build console: the product's core promise, playing on a loop. -->
    <div class="relative" data-reveal="scale" style="--reveal-delay: 150ms">
      <div class="hairline rounded-2xl p-2 shadow-2xl shadow-indigo-900/15">
        <div
          class="relative overflow-hidden rounded-xl bg-neutral-950 p-5 font-mono text-sm text-neutral-300"
          data-console
        >
          <div class="mb-5 flex items-center gap-3">
            <div class="flex items-center gap-1.5" aria-hidden="true">
              <span class="h-2.5 w-2.5 rounded-full bg-red-500/80"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-yellow-500/80"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-green-500/80"></span>
            </div>
            <p class="text-xs tracking-wide text-neutral-500">pkgr.app — build #128</p>
          </div>

          <p class="text-neutral-500">
            <span class="text-accent-400">$</span> git push origin main<span
              class="animate-blink text-neutral-400"
              aria-hidden="true">▌</span
            >
          </p>

          <ul class="mt-5 space-y-3.5">
            {
              steps.map((step, i) => (
                <li class="flex items-start gap-3" data-step={i}>
                  <span
                    class="mt-0.5 flex h-4 w-4 flex-none items-center justify-center"
                    aria-hidden="true"
                  >
                    <span
                      class="h-3.5 w-3.5 rounded-full border-2 border-neutral-700"
                      data-step-idle
                    />
                    <svg
                      class="hidden h-4 w-4 text-green-400"
                      data-step-done
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-neutral-400 transition-colors" data-step-label>
                      {step.label}
                    </span>
                    <span class="mt-0.5 block truncate text-xs text-neutral-600">{step.detail}</span>
                  </span>
                </li>
              ))
            }
          </ul>

          <div class="mt-5 h-1 overflow-hidden rounded-full bg-neutral-800" aria-hidden="true">
            <div
              class="bg-accent-500 h-full w-0 rounded-full transition-[width] duration-500 ease-out"
              data-console-bar
            >
            </div>
          </div>

          <div
            class="mt-5 flex items-center justify-between gap-3 rounded-lg border border-green-500/25 bg-green-500/10 px-4 py-3 opacity-0 transition-opacity duration-500"
            data-console-result
          >
            <span class="flex items-center gap-2 font-semibold text-green-300">
              <span aria-hidden="true">●</span> app-release.ipa
            </span>
            <span class="text-xs text-green-400/80">signed · ready</span>
          </div>

          <p class="sr-only" data-console-sr aria-live="polite"></p>
        </div>
      </div>

      <div
        class="glass hairline animate-float absolute -right-2 -bottom-16 hidden rounded-xl px-4 py-3 sm:block"
      >
        <p class="text-xs font-medium text-neutral-500">Build time</p>
        <p class="text-accent-600 font-mono text-2xl font-bold tabular-nums" data-console-timer>
          0m 00s
        </p>
      </div>

      <div
        class="glass hairline animate-float absolute -top-5 -left-4 hidden rounded-xl px-4 py-2.5 sm:block"
        style="animation-delay: -3s"
      >
        <p class="flex items-center gap-2 text-xs font-semibold text-neutral-700">
          <svg
            aria-hidden="true"
            class="text-accent-600 h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <rect x="5" y="11" width="14" height="9" rx="2"></rect>
            <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
          </svg>
          Vault unlocked
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const consoleEl = document.querySelector<HTMLElement>('[data-console]');

  if (consoleEl) {
    const stepEls = Array.from(consoleEl.querySelectorAll<HTMLElement>('[data-step]'));
    const bar = consoleEl.querySelector<HTMLElement>('[data-console-bar]');
    const result = consoleEl.querySelector<HTMLElement>('[data-console-result]');
    const timer = document.querySelector<HTMLElement>('[data-console-timer]');
    const srStatus = consoleEl.querySelector<HTMLElement>('[data-console-sr]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    const STEP_MS = 900;
    const HOLD_MS = 2600;
    // The timer counts toward a plausible finished build rather than real time,
    // so the number it lands on always matches the "3m 42s" claim.
    const TOTAL_SECONDS = 222;

    const setStep = (el: HTMLElement, state: 'idle' | 'active' | 'done'): void => {
      const idle = el.querySelector<HTMLElement>('[data-step-idle]');
      const done = el.querySelector<HTMLElement>('[data-step-done]');
      const label = el.querySelector<HTMLElement>('[data-step-label]');

      idle?.classList.toggle('hidden', state === 'done');
      idle?.classList.toggle('border-accent-400', state === 'active');
      idle?.classList.toggle('animate-pulse', state === 'active');
      idle?.classList.toggle('border-neutral-700', state === 'idle');
      done?.classList.toggle('hidden', state !== 'done');
      label?.classList.toggle('text-white', state === 'active');
      label?.classList.toggle('text-neutral-300', state === 'done');
      label?.classList.toggle('text-neutral-400', state === 'idle');
    };

    const formatTime = (seconds: number): string =>
      `${Math.floor(seconds / 60)}m ${String(Math.floor(seconds % 60)).padStart(2, '0')}s`;

    const showFinished = (): void => {
      stepEls.forEach((el) => setStep(el, 'done'));
      if (bar) bar.style.width = '100%';
      result?.classList.replace('opacity-0', 'opacity-100');
      if (timer) timer.textContent = formatTime(TOTAL_SECONDS);
      if (srStatus) srStatus.textContent = 'Build complete — app-release.ipa signed and ready.';
    };

    if (reduced.matches) {
      showFinished();
    } else {
      let timeouts: number[] = [];
      let rafId = 0;

      const reset = (): void => {
        stepEls.forEach((el) => setStep(el, 'idle'));
        if (bar) bar.style.width = '0%';
        result?.classList.replace('opacity-100', 'opacity-0');
        if (timer) timer.textContent = '0m 00s';
      };

      const runTimer = (durationMs: number): void => {
        const start = performance.now();
        const tick = (now: number): void => {
          const progress = Math.min((now - start) / durationMs, 1);
          if (timer) timer.textContent = formatTime(TOTAL_SECONDS * progress);
          if (progress < 1) rafId = requestAnimationFrame(tick);
        };
        rafId = requestAnimationFrame(tick);
      };

      const play = (): void => {
        reset();
        const runMs = stepEls.length * STEP_MS;
        runTimer(runMs);

        stepEls.forEach((el, i) => {
          timeouts.push(
            window.setTimeout(() => {
              setStep(el, 'active');
              if (bar) bar.style.width = `${((i + 0.5) / stepEls.length) * 100}%`;
            }, i * STEP_MS),
          );
          timeouts.push(
            window.setTimeout(
              () => {
                setStep(el, 'done');
                if (bar) bar.style.width = `${((i + 1) / stepEls.length) * 100}%`;
              },
              i * STEP_MS + STEP_MS * 0.75,
            ),
          );
        });

        timeouts.push(
          window.setTimeout(() => {
            result?.classList.replace('opacity-0', 'opacity-100');
            if (srStatus)
              srStatus.textContent = 'Build complete — app-release.ipa signed and ready.';
          }, runMs),
        );
        timeouts.push(window.setTimeout(play, runMs + HOLD_MS));
      };

      const stop = (): void => {
        timeouts.forEach(clearTimeout);
        timeouts = [];
        cancelAnimationFrame(rafId);
      };

      // Only animate while on screen — an off-screen loop is wasted work and
      // keeps the tab busy for no benefit.
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) play();
          else stop();
        },
        { threshold: 0.25 },
      );
      observer.observe(consoleEl);

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else if (consoleEl.getBoundingClientRect().top < window.innerHeight) play();
      });
    }
  }
</script>
