---
const steps = [
  {
    number: '01',
    title: 'Connect your repo',
    description: 'Install the pkgr.app GitHub App and pick the repo and branch to build.',
  },
  {
    number: '02',
    title: 'Configure once',
    description:
      'Set your platform, environment variables, and upload your signing secrets to the Vault.',
  },
  {
    number: '03',
    title: 'Push to build',
    description: 'Every push triggers a build automatically — or trigger one manually anytime.',
  },
  {
    number: '04',
    title: 'Get your binary',
    description: 'Download a signed Android or iOS artifact, with full logs and build history.',
  },
];
---

<section id="how-it-works" class="bg-neutral-50 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl" data-reveal>
      <p class="text-accent-600 inline-flex items-center gap-2 text-sm font-semibold">
        <span class="bg-accent-600 inline-block h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
        The process
      </p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
        How it works
      </h2>
      <p class="mt-4 text-lg text-neutral-600">
        From git push to signed binary in minutes, not a lost afternoon — no Xcode, no Android
        Studio, no local setup.
      </p>
    </div>

    <ol class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, i) => (
          <li
            class="relative rounded-xl border border-neutral-200 bg-white p-6 transition-all duration-200 hover:-translate-y-1 hover:shadow-lg"
            data-reveal
            style={`--reveal-delay: ${i * 90}ms`}
          >
            <span class="text-accent-600 text-sm font-bold">{step.number}</span>
            <h3 class="mt-3 text-base font-semibold text-neutral-900">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-neutral-600">{step.description}</p>
            {i < steps.length - 1 && (
              <div
                class="pointer-events-none absolute top-1/2 -right-5 z-10 hidden -translate-y-1/2 text-neutral-300 lg:block"
                aria-hidden="true"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>
