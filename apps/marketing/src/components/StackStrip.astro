---
const stack = [
  { name: 'Capacitor', icon: 'capacitor' },
  { name: 'Ionic', icon: 'ionic' },
  { name: 'Angular', icon: 'angular' },
  { name: 'React', icon: 'react' },
  { name: 'Vue', icon: 'vue' },
  { name: 'Android', icon: 'android' },
  { name: 'iOS', icon: 'ios' },
];

const icons: Record<string, string> = {
  capacitor:
    '<rect x="4" y="8.5" width="16" height="7" rx="3.5" /><line x1="12" y1="8.5" x2="12" y2="15.5" />',
  ionic: '<circle cx="12" cy="12" r="7.2" /><circle cx="12" cy="12" r="3" />',
  angular:
    '<path d="M12 3.5 19 6l-1 9.5L12 20l-6-4.5L5 6z" /><path d="M12 8l3 7h-1.7l-.6-1.5h-1.4l-.6 1.5H9l3-7z" />',
  react:
    '<circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none" /><ellipse cx="12" cy="12" rx="9" ry="3.6" /><ellipse cx="12" cy="12" rx="9" ry="3.6" transform="rotate(60 12 12)" /><ellipse cx="12" cy="12" rx="9" ry="3.6" transform="rotate(120 12 12)" />',
  vue: '<path d="M3 5h3.4L12 15l5.6-10H21L12 20.5z" />',
  android:
    '<path d="M8.5 10a3.5 3.5 0 0 1 7 0" /><path d="M6 10h12v6.5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 6 16.5z" /><line x1="7.5" y1="10.5" x2="7.5" y2="16" /><line x1="16.5" y1="10.5" x2="16.5" y2="16" /><line x1="8" y1="6" x2="9.3" y2="7.6" /><line x1="16" y1="6" x2="14.7" y2="7.6" />',
  ios: '<rect x="7" y="3.5" width="10" height="17" rx="2.4" /><line x1="10.3" y1="17.2" x2="13.7" y2="17.2" />',
};

// Duplicated 4x so the marquee never shows a gap, even on ultra-wide viewports —
// see the `marquee` keyframes comment in global.css for the math.
const copyCount = 4;
const copies = Array.from({ length: copyCount }, (_, copyIndex) => copyIndex);
---

<section class="border-y border-neutral-200 bg-white py-14">
  <div class="mx-auto max-w-6xl px-6">
    <p class="text-center text-xs font-semibold tracking-[0.2em] text-neutral-500 uppercase">
      Works with your stack
    </p>
  </div>

  <div
    class="group relative mt-7 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)]"
  >
    <ul
      class="animate-marquee flex w-max items-center gap-12 group-hover:[animation-play-state:paused]"
    >
      {
        copies.map((copyIndex) =>
          stack.map((item) => (
            <li
              class="flex flex-none items-center gap-2.5 text-neutral-700 transition-colors hover:text-accent-600"
              aria-hidden={copyIndex > 0 ? 'true' : undefined}
            >
              <span
                class="bg-accent-50 text-accent-600 flex h-8 w-8 flex-none items-center justify-center rounded-lg"
                aria-hidden="true"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons[item.icon]}
                />
              </span>
              <span class="text-lg font-semibold whitespace-nowrap">{item.name}</span>
            </li>
          )),
        )
      }
    </ul>
  </div>
</section>
