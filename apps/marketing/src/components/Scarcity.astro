---
import { FOUNDER_SPOTS, FOUNDER_PRICE_CHF, ACCESS_DEADLINE } from '../config';

const stats = [
  {
    value: String(FOUNDER_SPOTS),
    label: 'Founding spots total — no more will ever be sold at this price.',
  },
  { value: `CHF ${FOUNDER_PRICE_CHF}`, label: 'Once. Not per month, not per year — forever.' },
  { value: '0 risk', label: `Refunded in full if we're not live by ${ACCESS_DEADLINE}.` },
];
---

<section id="founding-access" class="py-24 sm:py-32">
  <div class="mx-auto max-w-3xl px-6 text-center" data-reveal>
    <p class="text-accent-600 inline-flex items-center gap-1.5 text-sm font-semibold">
      <svg aria-hidden="true" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" stroke="none">
        <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z"></path>
      </svg>
      Founding access
    </p>
    <h2 class="mt-2 text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
      Only {FOUNDER_SPOTS} lifetime spots, ever
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-neutral-600">
      pkgr.app will launch as a subscription. The one-time CHF {FOUNDER_PRICE_CHF} lifetime deal exists
      for exactly {FOUNDER_SPOTS} early developers who back the product now — and it's gone for good once
      that cap is reached or the product goes public, whichever comes first.
    </p>

    <div class="mt-10 grid gap-4 text-left sm:grid-cols-3">
      {
        stats.map((stat, i) => (
          <div
            class="rounded-xl border border-neutral-200 p-5 transition-all duration-200 hover:-translate-y-1 hover:shadow-lg"
            data-reveal
            style={`--reveal-delay: ${100 + i * 90}ms`}
          >
            <p class="text-2xl font-bold text-neutral-900">{stat.value}</p>
            <p class="mt-1 text-sm text-neutral-600">{stat.label}</p>
          </div>
        ))
      }
    </div>

    <a
      href="/early-access"
      class="bg-accent-600 hover:bg-accent-700 focus-visible:ring-accent-600 mt-10 inline-flex items-center justify-center rounded-full px-6 py-3 text-base font-semibold text-white shadow-sm transition-all duration-150 hover:-translate-y-0.5 hover:shadow-lg focus-visible:ring-2 focus-visible:outline-none active:translate-y-0"
    >
      Claim one of {FOUNDER_SPOTS} spots
    </a>
  </div>
</section>
