---
import { FOUNDER_SPOTS, FOUNDER_PRICE_CHF, ACCESS_DEADLINE } from '../config';
---

<section class="py-24 sm:py-32">
  <div class="mx-auto max-w-5xl px-6">
    <div
      class="relative overflow-hidden rounded-3xl bg-neutral-900 px-6 py-16 text-center sm:px-16 sm:py-20"
      data-reveal
    >
      <div
        aria-hidden="true"
        class="from-accent-600/30 pointer-events-none absolute inset-x-0 -top-32 -z-0 h-[320px] bg-gradient-to-b to-transparent blur-3xl"
      >
      </div>

      <div class="relative">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Lock in Starter access before it's gone
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-lg text-neutral-300">
          {FOUNDER_SPOTS} founding spots, CHF {FOUNDER_PRICE_CHF} once — then Starter goes
          subscription-only for everyone else. Refunded in full if we're not live by{' '}
          {ACCESS_DEADLINE}.
        </p>

        <div class="mt-10 flex flex-col items-center gap-4">
          <a
            href="/early-access"
            class="rounded-full bg-white px-8 py-3.5 text-base font-semibold text-neutral-900 shadow-lg transition-all duration-150 hover:-translate-y-0.5 hover:bg-neutral-100 hover:shadow-xl focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-900 focus-visible:outline-none active:translate-y-0"
          >
            Get lifetime Starter access
          </a>
          <p class="text-sm text-neutral-400">Zero risk — full refund if we miss the deadline.</p>
        </div>
      </div>
    </div>
  </div>
</section>
