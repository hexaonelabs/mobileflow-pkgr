---
const rows = [
  {
    before: 'A Mac you have to own, borrow or rent by the hour',
    after: 'Any machine with a browser — Linux, Windows, a Chromebook',
  },
  {
    before: 'Keystores in email threads, Slack DMs and Downloads folders',
    after: 'Sealed in the Vault, injected only into the run that needs them',
  },
  {
    before: 'A red X and three lines of log, with no history behind it',
    after: 'Status, duration, commit and full logs kept for every run',
  },
  {
    before: 'An afternoon of your week, every single release',
    after: 'About three minutes, unattended, while you keep working',
  },
  {
    before: "A black-box build farm you can't inspect or leave",
    after: 'GitHub Actions — the runner you already trust, no lock-in',
  },
];

const metrics = [
  { value: 0, suffix: '', label: 'Macs required', hint: 'Now, and at any point later.' },
  { value: 2, suffix: '', label: 'Platforms per push', hint: 'iOS and Android, same run.' },
  { value: 100, suffix: '%', label: 'Builds traceable', hint: 'Every run, logs kept.' },
  { value: 1, suffix: '', label: 'Payment, ever', hint: 'Founding access, no renewal.' },
];

const trust = [
  'Runs on GitHub Actions',
  'EU data residency',
  'Built with GDPR in mind',
  'Ephemeral isolated runners',
  'No vendor lock-in',
];
---

<section id="shift" class="relative isolate scroll-mt-20 overflow-hidden bg-neutral-50 py-24 sm:py-32">
  <div class="aurora" aria-hidden="true">
    <div
      class="aurora-blob animate-drift top-0 left-1/2 h-[420px] w-[760px] -translate-x-1/2 opacity-15"
      style="background: radial-gradient(closest-side, var(--color-accent-200), transparent);"
    >
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-2xl text-center" data-reveal="up">
      <p class="text-accent-700 inline-flex items-center gap-2 text-sm font-semibold">
        <span class="bg-accent-600 inline-block h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
        What actually changes
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-balance text-neutral-900 sm:text-5xl">
        Same app. Same team. Different Friday.
      </h2>
    </div>

    <div class="mt-14 overflow-hidden rounded-2xl bg-white shadow-xl shadow-indigo-900/10 ring-1 ring-neutral-200" data-reveal="up">
      <div class="grid sm:grid-cols-2">
        <div class="border-b border-neutral-200 bg-neutral-100/60 px-6 py-4 sm:border-r sm:border-b-0">
          <p class="flex items-center gap-2 text-sm font-semibold text-neutral-500">
            <svg
              aria-hidden="true"
              class="h-4 w-4 flex-none"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <line x1="6" y1="6" x2="18" y2="18"></line>
              <line x1="18" y1="6" x2="6" y2="18"></line>
            </svg>
            Today, without pkgr.app
          </p>
        </div>
        <div class="from-accent-600 to-accent-500 border-b border-neutral-200 bg-gradient-to-r px-6 py-4 sm:border-b-0">
          <p class="flex items-center gap-2 text-sm font-semibold text-white">
            <svg
              aria-hidden="true"
              class="h-4 w-4 flex-none"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4.5 12.75l6 6 9-13.5"></path>
            </svg>
            From your next push
          </p>
        </div>
      </div>

      <dl class="grid sm:grid-cols-2">
        {
          rows.map((row, i) => (
            <>
              <div
                class:list={[
                  'border-b border-neutral-100 px-6 py-5 sm:border-r',
                  i === rows.length - 1 && 'sm:border-b-0',
                ]}
                data-reveal="left"
                style={`--reveal-delay: ${i * 60}ms`}
              >
                <dt class="sr-only">Without pkgr.app</dt>
                <dd class="text-sm leading-relaxed text-neutral-500 line-through decoration-neutral-300">
                  {row.before}
                </dd>
              </div>
              <div
                class:list={[
                  'bg-accent-50/40 border-b border-neutral-100 px-6 py-5',
                  i === rows.length - 1 && 'border-b-0',
                ]}
                data-reveal="right"
                style={`--reveal-delay: ${i * 60 + 90}ms`}
              >
                <dt class="sr-only">With pkgr.app</dt>
                <dd class="text-sm leading-relaxed font-medium text-neutral-900">{row.after}</dd>
              </div>
            </>
          ))
        }
      </dl>
    </div>

    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-metrics>
      {
        metrics.map((metric, i) => (
          <li
            class="glass hairline lift rounded-2xl p-6"
            data-reveal="up"
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <p class="text-accent-700 font-mono text-4xl font-extrabold tabular-nums">
              <span data-metric-value={metric.value}>{metric.value}</span>
              {metric.suffix}
            </p>
            <p class="mt-2 text-sm font-semibold text-neutral-900">{metric.label}</p>
            <p class="mt-1 text-xs text-neutral-500">{metric.hint}</p>
          </li>
        ))
      }
    </ul>

    <ul class="mt-14 flex flex-wrap items-center justify-center gap-x-3 gap-y-3" data-reveal="up">
      {
        trust.map((item) => (
          <li class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-medium text-neutral-700 ring-1 ring-neutral-200">
            <svg
              aria-hidden="true"
              class="text-accent-600 h-3.5 w-3.5 flex-none"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  const metricsRoot = document.querySelector<HTMLElement>('[data-metrics]');

  if (metricsRoot && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const countUp = (el: HTMLElement): void => {
      const target = Number(el.getAttribute('data-metric-value'));
      if (!Number.isFinite(target) || target === 0) return;

      const DURATION = 1100;
      const start = performance.now();
      const tick = (now: number): void => {
        const linear = Math.min((now - start) / DURATION, 1);
        // Ease-out cubic, so the number decelerates into its final value.
        const eased = 1 - Math.pow(1 - linear, 3);
        el.textContent = String(Math.round(target * eased));
        if (linear < 1) requestAnimationFrame(tick);
      };
      el.textContent = '0';
      requestAnimationFrame(tick);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            countUp(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.6 },
    );

    metricsRoot.querySelectorAll<HTMLElement>('[data-metric-value]').forEach((el) => {
      observer.observe(el);
    });
  }
</script>
