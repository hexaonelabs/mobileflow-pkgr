---
const builds = [
  { branch: 'main', commit: 'a1b2c3d', status: 'Success', duration: '3m 42s' },
  { branch: 'main', commit: '9e8f7a6', status: 'Success', duration: '4m 05s' },
  { branch: 'feature/onboarding', commit: '5d4c3b2', status: 'Failed', duration: '1m 58s' },
];

const statusStyles: Record<string, string> = {
  Success: 'bg-green-50 text-green-700',
  Failed: 'bg-red-50 text-red-700',
};
---

<section class="bg-neutral-50 py-24 sm:py-32">
  <div class="mx-auto grid max-w-6xl items-center gap-16 px-6 lg:grid-cols-2">
    <div data-reveal>
      <p class="text-accent-600 inline-flex items-center gap-2 text-sm font-semibold">
        <span class="bg-accent-600 inline-block h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
        Visibility
      </p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
        No more "did it even build?"
      </h2>
      <p class="mt-4 text-lg text-neutral-600">
        See the status, duration, commit, and branch for every build — with full logs available the
        moment a run completes. No more guessing whether last night's release actually shipped.
      </p>
      <a
        href="#why-pkgr"
        class="text-accent-600 hover:text-accent-700 focus-visible:ring-accent-600 mt-8 inline-flex items-center gap-1 rounded-sm text-sm font-semibold focus-visible:ring-2 focus-visible:outline-none"
      >
        Why teams choose pkgr.app
        <svg
          aria-hidden="true"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
        </svg>
      </a>
    </div>

    <div
      class="overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm"
      data-reveal
      style="--reveal-delay: 100ms"
    >
      <table class="w-full text-left text-sm">
        <caption class="sr-only">Recent build history</caption>
        <thead class="border-b border-neutral-200 bg-neutral-50 text-neutral-500">
          <tr>
            <th scope="col" class="px-5 py-3 font-medium">Branch</th>
            <th scope="col" class="px-5 py-3 font-medium">Commit</th>
            <th scope="col" class="px-5 py-3 font-medium">Status</th>
            <th scope="col" class="px-5 py-3 font-medium">Duration</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-100">
          {
            builds.map((build) => (
              <tr class="transition-colors duration-150 hover:bg-neutral-50">
                <td class="px-5 py-4 font-medium text-neutral-900">{build.branch}</td>
                <td class="px-5 py-4 font-mono text-neutral-500">{build.commit}</td>
                <td class="px-5 py-4">
                  <span
                    class:list={[
                      'rounded-full px-2.5 py-1 text-xs font-medium',
                      statusStyles[build.status],
                    ]}
                  >
                    {build.status}
                  </span>
                </td>
                <td class="px-5 py-4 text-neutral-500">{build.duration}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
