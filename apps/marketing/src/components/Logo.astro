---
interface Props {
  class?: string;
}

const { class: className = 'h-7 w-7' } = Astro.props;
---

<svg viewBox="0 0 24 24" class={className} aria-hidden="true">
  <rect width="24" height="24" rx="6" class="fill-accent-600"></rect>
  <path
    d="M6 16.5V7.5l6 6 6-6v9"
